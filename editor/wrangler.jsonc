{
  // The WYSIWYG editor — a SEPARATE Worker from production `svdsa` (which stays
  // pure static). Deployed to its own domain behind Cloudflare Access.
  // See plans/svdsa-wysiwyg-phase0.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Named `edit` rather than `svdsa-edit` — the account subdomain already says
  // svdsa, so this reads edit.cameron-test-svdsa.workers.dev.
  "name": "edit",
  // Pinned so a deploy can't land in the wrong account. DSA test account.
  "account_id": "4ce5029d216dd48d4516b29665d12e5a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // gray-matter (frontmatter serialize) needs Node Buffer at runtime.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The editor SPA (web/ → dist/, built by Vite). The Worker owns /api/* via
  // run_worker_first; static assets serve the SPA for every other path.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Non-secret config — plain variables, safe to commit. Filled per deployment
  // by `bun run setup:editor`. The ONLY secret is GH_PRIVATE_KEY (and, for the
  // GitLab host, GITLAB_TOKEN), set via `wrangler secret put` — never committed.
  "vars": {
    "GIT_HOST": "github",
    "EDITOR_DEFAULT_BASE": "red",
    "GH_REPO": "cinderblock/svdsa.org",
    "GH_APP_ID": "4368113",
    "GH_INSTALLATION_ID": "148335084",
    "GITLAB_PROJECT_ID": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
  },
}
