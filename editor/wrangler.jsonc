{
  // The WYSIWYG editor — a SEPARATE Worker from production `svdsa` (which stays
  // pure static). Deployed to its own domain behind Cloudflare Access.
  // See plans/svdsa-wysiwyg-phase0.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "svdsa-edit",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // gray-matter (frontmatter serialize) needs Node Buffer at runtime.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret config — plain variables, safe to commit. Filled per deployment
  // by `bun run setup:editor`. The ONLY secret is GH_PRIVATE_KEY (and, for the
  // GitLab host, GITLAB_TOKEN), set via `wrangler secret put` — never committed.
  "vars": {
    "GIT_HOST": "github",
    "EDITOR_DEFAULT_BASE": "red",
    "GH_APP_ID": "4368113",
    "GH_INSTALLATION_ID": "148335084",
    "GITLAB_PROJECT_ID": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
  },
}
