{
  "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  // The editor is its own workspace with its own tsconfig (browser + Worker
  // libs, not the site's). `bun run typecheck` runs both. Files under editor/
  // that the tests import are still checked — as imports, under these options.
  "exclude": ["editor", "node_modules", "build"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
