{
  "name": "svdsa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:content && react-router dev",
    "build:content": "bun run scripts/build-content.ts",
    "build": "bun run build:content && react-router build",
    "migrate": "bun run scripts/fetch-wp-content.ts",
    "setup:editor": "bun run scripts/setup-editor.ts",
    "editor:dev": "vite --config editor/vite.config.ts",
    "editor:build": "vite build --config editor/vite.config.ts",
    "editor:deploy": "bun run editor:build && cd editor && wrangler deploy",
    "preview": "vite preview --outDir build/client",
    "deploy": "bun run build && wrangler deploy",
    "cf:dev": "bun run build && wrangler dev",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "bun run build:content && react-router typegen && tsc",
    "prepare": "lefthook install",
    "lint:content": "bun run scripts/lint-content.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@milkdown/crepe": "^7.21.3",
    "@monaco-editor/react": "^4.7.0",
    "@react-router/node": "^8.1.0",
    "isbot": "^5.1.44",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^8.1.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.4",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.57.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.1.2",
    "wrangler": "^4.112.0"
  }
}
